# ===================================================================
# Context Pilot - Production Environment Configuration (.env)
# ===================================================================

# 1. AI Impact Engine (Google Gemini)
# Get your Gemini API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Paystack Payment Gateway API Keys (For Live or Test Billing)
# Get keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# 3. GitHub OAuth is configured in Supabase Dashboard -> Authentication -> Providers
# Optional dedicated key for encrypting stored GitHub OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a key is derived from SUPABASE_SERVICE_ROLE_KEY (server-only).
GITHUB_TOKEN_ENCRYPTION_KEY=

# 4. Master Administration Portal Access (Access by typing /admin next to domain)
ADMIN_EMAIL=

# 5. Supabase Database Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public variables baked into the Vite frontend at build time
VITE_SUPABASE_URL=
VITE_
# 6. Server Runtime Port
PORT=3000
NODE_ENV=development

# 7. Public app URL (used to build the GitHub OAuth redirect when the request
#    origin is not available, e.g. behind a proxy)
APP_URL=

# 8. Conversion rate applied when a fixed NGN promo discount is charged in USD
USD_NGN_RATE=1500
