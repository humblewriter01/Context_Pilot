# ===================================================================
# Context Pilot - Production Environment Configuration (.env)
# ===================================================================

# 1. AI Impact Engine (Google Gemini or DeepSeek API)
# Get your Gemini API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Paystack Payment Gateway API Keys (For Live or Test Billing)
# Get keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# 3. GitHub API Integration
# Option A: Personal Access Token (for server public repo rate limits)
GITHUB_TOKEN=

# Option B: GitHub OAuth App (for 1-click user connection without typing tokens)
# Create OAuth App at: https://github.com/settings/developers
# Authorization Callback URL: https://<your-domain>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 4. Master Administration Portal Access (Access by typing /admin next to domain)
ADMIN_EMAIL=admin@contextpilot.com
ADMIN_PASSWORD=

# 5. Supabase Database Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 6. Server Runtime Port
PORT=3000
NODE_ENV=development
